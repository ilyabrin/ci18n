# Normalize line endings in sources and docs, the usual arrangement.
* text=auto

# Fuzz seeds are byte sequences, not text. Normalizing them destroys the
# point: the CRLF seed came back from git as LF, which made it a duplicate of
# the plain one, and a checkout on Windows would have given every other seed
# CRLF it was never meant to have.
#
# The last matching line wins, so this has to come after the rule above.
tests/fuzz_corpus/** -text -diff

# Written byte for byte by tests/compiled/make_stress.py: a BOM, CRLF and lone
# CRs that a checkout must not normalise away.
tests/compiled/stress.txt -text

# Generated from CLDR by tools/cldr_samples.py. Folded in pull request diffs,
# but still diffable, since reading the diff is how a CLDR update is reviewed.
tests/cldr_samples.h linguist-generated=true
tests/cldr_numbers.h linguist-generated=true

# Generated by tools/ci18n_compile from the .txt beside each; CI checks
# they still match.
examples/arduino/*/*.h linguist-generated=true

# Run by sh, which a CRLF checkout would break.
*.sh text eol=lf
