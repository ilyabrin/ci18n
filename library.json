{
  "name": "ci18n",
  "version": "2.18.0",
  "description": "Translations for C in one header: plurals for 71 languages, formatting, right-to-left text. Translations can be compiled into flash, where they take no RAM.",
  "keywords": ["i18n", "l10n", "translation", "plural", "localization", "utf-8"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ilyabrin/ci18n.git"
  },
  "authors": [
    {
      "name": "Ilya Brin",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/ilyabrin/ci18n",
  "frameworks": "*",
  "platforms": "*",
  "headers": "ci18n.h",
  "examples": ["examples/arduino/*/*.ino"],
  "export": {
    "include": [
      "include",
      "src",
      "tools/ci18n_compile.c",
      "examples/arduino",
      "library.json",
      "library.properties",
      "LICENSE",
      "README.md"
    ]
  }
}
